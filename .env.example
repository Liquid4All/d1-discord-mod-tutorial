# Liquid Console > Dashboard > API Keys
LIQUID_API_KEY=

# Discord Developer Portal > your application > Bot > Token
DISCORD_BOT_TOKEN=

# Comma-separated IDs of the text channels to monitor in one server.
DISCORD_CHANNEL_IDS=
# One private report channel in that server, excluded from the list above.
# This is the same value as DISCORD_LOG_CHANNEL_ID in the original bot.
DISCORD_REVIEW_CHANNEL_ID=

